{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SPY mathematical claims",
  "type": "object",
  "required": [
    "schema_version", "math_claims_schema_version",
    "task",
    "asset",
    "target_definition",
    "target_horizon_days",
    "fold_protocol",
    "folds",
    "models",
    "metrics",
    "oof_rows_per_model",
    "canonical_run_id", "canonical_experiment_package_version", "validator_release_version",
    "manifest_schema_version", "reference_artifact_commit", "release_validator_commit",
    "canonical_experiment_code_commit",
    "claims_generator_sha256",
    "mathematical_contract_sha256",
    "reference_manifest_version",
    "generated_from_artifacts",
    "non_claims"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0", "1.1"]},
    "task": {"type": "string", "minLength": 1},
    "asset": {"type": "string", "minLength": 1},
    "target_definition": {"type": "string", "minLength": 1},
    "target_horizon_days": {"type": "integer", "minimum": 1},
    "fold_protocol": {"type": "string", "minLength": 1},
    "folds": {"type": "integer", "minimum": 1},
    "models": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "metrics": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "oof_rows_per_model": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "canonical_run_id": {"type": "string", "minLength": 1},
    "math_claims_schema_version": {"type": "string", "const": "1.0"},
    "canonical_experiment_package_version": {"type": "string", "minLength": 1},
    "validator_release_version": {"type": "string", "minLength": 1},
    "manifest_schema_version": {"type": "integer", "const": 3},
    "canonical_experiment_code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "reference_artifact_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "release_validator_commit": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      ]
    },
    "claims_generator_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mathematical_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mathematical_contract_normalized_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mathematical_contract_hash_mode": {"const": "git-lf-v1"},
    "reference_manifest_version": {"type": "integer", "const": 3},
    "generated_from_artifacts": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "non_claims": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
  },
  "additionalProperties": true
}
